FROM python:3.11-slim

# Security: Create non-root user first
RUN groupadd -r appuser && useradd -r -g appuser -u 1000 appuser

# Security: Update packages and install minimal dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /tmp/* /var/tmp/*

# Security: Create app directory with proper permissions
WORKDIR /app
RUN chown appuser:appuser /app

# Security: Copy requirements as non-root user
COPY --chown=appuser:appuser requirements.txt .

# Security: Install Python dependencies with no cache
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt \
    && pip cache purge

# Security: Copy application code with proper ownership
COPY --chown=appuser:appuser app.py .

# Security: Create secure version of the app
RUN cat > app_secure.py << 'EOF'
#!/usr/bin/env python3
"""
Secure Flask application demonstrating proper security practices.
This is the hardened version of the vulnerable app for comparison.
"""

from flask import Flask, request, jsonify, escape
import subprocess
import os
import re
import logging

app = Flask(__name__)

# Security: Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Security: Whitelist of allowed commands
ALLOWED_COMMANDS = {
    'date': ['date'],
    'whoami': ['whoami'],
    'pwd': ['pwd'],
    'ls': ['ls', '-la'],
    'ps': ['ps', 'aux']
}

@app.route('/')
def index():
    return jsonify({
        "message": "Secure Container Application",
        "version": "1.0.0",
        "security": "hardened",
        "endpoints": ["/health", "/info", "/secure-execute"]
    })

@app.route('/secure-execute', methods=['POST'])
def secure_execute():
    """
    Secure command execution with proper validation
    """
    try:
        data = request.get_json()
        if not data or 'command' not in data:
            return jsonify({"error": "Missing 'command' parameter"}), 400

        command_name = data['command'].strip().lower()

        # Security: Command whitelist validation
        if command_name not in ALLOWED_COMMANDS:
            logger.warning(f"Blocked unauthorized command: {command_name}")
            return jsonify({
                "error": "Command not allowed",
                "allowed_commands": list(ALLOWED_COMMANDS.keys())
            }), 403

        # Security: Execute only whitelisted commands
        cmd_args = ALLOWED_COMMANDS[command_name]

        try:
            result = subprocess.run(
                cmd_args,
                capture_output=True,
                text=True,
                timeout=5,
                shell=False  # Security: No shell execution
            )

            logger.info(f"Executed secure command: {command_name}")

            return jsonify({
                "command": command_name,
                "return_code": result.returncode,
                "stdout": result.stdout,
                "stderr": result.stderr
            })

        except subprocess.TimeoutExpired:
            return jsonify({"error": "Command timed out"}), 408

    except Exception as e:
        logger.error(f"Error in secure execution: {str(e)}")
        return jsonify({"error": "Internal server error"}), 500

@app.route('/info')
def info():
    """Provide safe system information"""
    try:
        safe_info = {
            "container_user": os.getenv('USER', 'unknown'),
            "python_version": os.sys.version,
            "working_directory": os.getcwd(),
            "environment": "secure_container",
            "security_features": [
                "No privileged access",
                "Read-only filesystem",
                "Minimal capabilities",
                "Command whitelisting",
                "Input validation",
                "No shell execution"
            ]
        }
        return jsonify(safe_info)
    except Exception as e:
        logger.error(f"Error getting info: {str(e)}")
        return jsonify({"error": "Unable to retrieve information"}), 500

@app.route('/health')
def health():
    """Health check endpoint"""
    return jsonify({
        "status": "healthy",
        "pid": os.getpid(),
        "security_mode": "hardened"
    })

@app.errorhandler(404)
def not_found(error):
    return jsonify({"error": "Endpoint not found"}), 404

@app.errorhandler(500)
def internal_error(error):
    logger.error(f"Internal server error: {str(error)}")
    return jsonify({"error": "Internal server error"}), 500

if __name__ == '__main__':
    logger.info("Starting secure container application")
    logger.info("Security features enabled: Command whitelisting, Input validation, No shell execution")

    # Security: Bind only to localhost in production
    app.run(host='0.0.0.0', port=5000, debug=False, threaded=True)
EOF

# Security: Make the secure app executable
RUN chmod +x app_secure.py

# Security: Switch to non-root user
USER appuser

# Security: Expose port
EXPOSE 5000

# Security: Set secure environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV FLASK_ENV=production
ENV FLASK_DEBUG=0

# Security: Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Security: Use the secure application
CMD ["python", "app_secure.py"]
